# Réglages de la pile montée le temps d'un test d'intrusion OWASP ZAP.
#
# Toutes les valeurs ci-dessous sont jetables et publiques : cette pile vit quelques
# minutes dans le pipeline, sur une base vide, puis disparaît avec ses volumes. Aucun
# secret réel ne doit jamais figurer ici — les vrais vivent dans l'onglet
# « Environment » de Dokploy, et nulle part ailleurs.
#
# DJANGO_DEBUG=False est essentiel : c'est la configuration de production qui doit être
# analysée, pages d'erreur détaillées comprises — leur absence, justement, est contrôlée.

DJANGO_SECRET_KEY=cle-de-scan-sans-valeur-ne-jamais-utiliser-ailleurs-7b31d9f4e2a6
DJANGO_DEBUG=False
# `web` (Nginx) et `api` (Django) sont les noms des conteneurs attaqués par ZAP à
# travers le réseau Docker ; Django refuse tout nom d'hôte non déclaré.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,api

POSTGRES_DB=fasolib
POSTGRES_USER=fasolib
POSTGRES_PASSWORD=mot-de-passe-de-scan-sans-valeur
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

S3_ENDPOINT_URL=http://s3:7070
S3_REGION=us-east-1
S3_PRIVATE_BUCKET=fasolib-prive
S3_PUBLIC_BUCKET=media
S3_ACCESS_KEY=fasolib
S3_SECRET_KEY=cle-de-stockage-de-scan-sans-valeur

CORS_ALLOWED_ORIGINS=http://web
FRONTEND_URL=http://web

# Nginx est le seul proxy devant Django dans cette pile : pas de Traefik.
NUM_PROXIES=1

EMAIL_HOST=smtp.exemple-de-scan.test
GENIUSPAY_API_SECRET=secret-de-scan-sans-valeur
GENIUSPAY_WEBHOOK_SECRET=secret-de-notification-de-scan-sans-valeur
GENIUSPAY_SIMULATION=False
