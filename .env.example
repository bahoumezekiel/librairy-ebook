# Copier ce fichier en `.env` puis renseigner les valeurs. Ne jamais versionner `.env`.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (lu par Django et par docker-compose)
POSTGRES_DB=librairie
POSTGRES_USER=librairie
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

# Redis : cache de Django et limitation des tentatives de connexion
REDIS_URL=redis://127.0.0.1:6379/0

# Origines autorisées à appeler l'API (site React)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Nombre de proxys devant Django (0 en développement, 1 derrière Nginx)
NUM_PROXIES=0

# Stockage objet compatible S3 (passerelle Versity en développement)
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_PRIVATE_BUCKET=librairie-prive
S3_PUBLIC_BUCKET=librairie-public
S3_ACCESS_KEY=librairie
S3_SECRET_KEY=

# Site React (retour du client après le paiement)
FRONTEND_URL=http://localhost:5173

# Genius Pay (clés sandbox en développement)
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=

# Celery : file des tâches (une autre base Redis que le cache)
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# Envoi des e-mails (lien de réinitialisation du mot de passe).
# Sans EMAIL_HOST, les messages s'affichent dans la console : utile en développement,
# refusé en production (l'API ne démarre pas).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FasoLib <ne-pas-repondre@e-busness.cloud>

# Paiement simulé pour le développement, sans clés Genius Pay (interdit si DJANGO_DEBUG=False)
GENIUSPAY_SIMULATION=False

# --- En production, en plus ---------------------------------------------------
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=fasolib.e-busness.cloud
# CORS_ALLOWED_ORIGINS=https://fasolib.e-busness.cloud   (même domaine que l'API : rien à ajouter en réalité)
# FRONTEND_URL=https://fasolib.e-busness.cloud           (sert aussi d'adresse aux couvertures)
# NUM_PROXIES=2                                          (Traefik, puis Nginx, devant Django)
# S3_PUBLIC_BUCKET=media                                 (c'est aussi le chemin servi par Nginx :
#   un autre nom et l'API refuse de démarrer, car plus aucune couverture ne s'afficherait)
# GENIUSPAY_API_SECRET, GENIUSPAY_WEBHOOK_SECRET et EMAIL_HOST sont alors obligatoires :
#   l'API refuse de démarrer sans eux.
# Une clé Django se génère ainsi :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
